---
import AboutMeSection from "@/components/AboutMeSection.astro";
import ContactSection from "@/components/ContactSection.astro";
import ExpertiseSection from "@/components/ExpertiseSection.astro";
import HeroSection from "@/components/HeroSection.astro";
import HomeFooter from "@/components/HomeFooter.astro";
import { Navbar } from "@/components/Navbar";
import ProjectsSection from "@/components/ProjectsSection.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div
    class="bg-gradient-to-br from-zinc-950 via-neutral-950 to-stone-950 text-white relative overflow-hidden"
  >
    {/* Ambient lighting */}
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
      <div
        class="absolute top-0 left-1/4 w-[800px] h-[800px] bg-radial from-amber-500/5 via-transparent to-transparent blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-0 right-1/4 w-[800px] h-[800px] bg-radial from-rose-500/5 via-transparent to-transparent blur-3xl"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[1200px] h-[1200px] bg-radial from-violet-500/3 via-transparent to-transparent blur-3xl"
      >
      </div>
    </div>

    <Navbar client:idle />
    <HeroSection />
    <AboutMeSection />
    <ExpertiseSection />
    <ProjectsSection />
    <ContactSection />
    <HomeFooter />
  </div>
</Layout>
