---
import Layout, { type LayoutMetaData } from "@/layouts/Layout.astro";

const cvMetaData: LayoutMetaData = {
  title: "Diego Peralta - Desarrollador Full-Stack | CV",
  pathname: Astro.url.pathname,
  description:
    "Currículum de Diego Peralta, desarrollador Full-Stack Jr. especializado en React (TypeScript) y C#/ASP.NET Core. Experiencia en Node.js, arquitecturas limpias (Hexagonal, Vertical Slice, MVC) y creación de APIs REST seguras con JWT y OAuth2. Manejo de PostgreSQL y MySQL, testing con Vitest y MSW, y entornos de desarrollo con Docker.",
  keywords:
    "Diego Peralta, CV, currículum, desarrollador full-stack, React, TypeScript, C#, ASP.NET Core, Node.js, PostgreSQL, MySQL, Docker, Git, Tailwind CSS, Shadcn UI, TanStack, Zod, Express, JWT, OAuth2, arquitectura hexagonal, vertical slice, MVC, API REST, Vitest, MSW, desarrollo web, software",
  ogDescription:
    "Perfil profesional y CV de Diego Peralta, especializado en React, TypeScript y C#/ASP.NET Core. Experiencia en arquitecturas limpias, APIs REST seguras y bases de datos relacionales.",
};
---

<Layout {...cvMetaData}>
  <div class="bg-white text-gray-800 max-w-4xl mx-auto p-6 print:p-0">
    <!-- Encabezado -->
    <header class="mb-6">
      <h1 class="text-3xl text-center font-bold uppercase mb-1">
        Diego Peralta Martinez
      </h1>
      <div class="h-[1px] w-full bg-black mb-6"></div>
      <ul class="flex list-disc list-inside flex-wrap gap-x-4 text-sm">
        <li>CDMX</li>
        <li>
          <a
            class="underline"
            href="https://www.linkedin.com/in/diego-peralta-martinez-a9791b378/"
            target="_blank"
          >
            Linkedin
          </a>
        </li>
        <li>diego.peraltam03@gmail.com</li>
      </ul>
    </header>

    <!-- Introducción -->
    <p class="mb-6 text-justify">
      Desarrollador Full-Stack Jr. enfocado en la creación de aplicaciones
      escalables y mantenibles. Mi stack principal se basa en React (TypeScript)
      para el frontend y C# (ASP.NET Core) o Node.js para el backend. Aplico
      principios de Clean Architecture y patrones MVC para asegurar un código
      organizado y fácil de testear. Actualmente, estoy expandiendo mis
      capacidades en el ecosistema de PHP/Laravel con Inertia.js, aplicando mi
      experiencia en arquitecturas robustas y entornos de desarrollo con Docker.
    </p>

    <div class="h-[1px] w-full bg-black mb-6"></div>

    <!-- Tecnologías -->
    <section class="mb-6">
      <h2 class="text-xl font-bold uppercase mb-3">Tecnologías</h2>
      <div class="grid grid-cols-1 gap-4">
        <div>
          <h3 class="font-semibold">Backend & Arquitectura:</h3>
          <ul class="list-disc pl-5">
            <li>
              C# (ASP.NET Core), PHP (Laravel - Aprendizaje activo), Node.js
              (Express), Vertical Slice, Arquitectura Hexagonal, MVC, API REST,
              JWT, OAuth2/OpenID Connect.
            </li>
          </ul>
        </div>

        <div>
          <h3 class="font-semibold">Frontend:</h3>
          <ul class="list-disc pl-5">
            <li>
              React, TypeScript , TanStack (Query & Router), Axios, Shadcn UI,
              Tailwind CSS , Zod.
            </li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold">Bases de Datos & Testing:</h3>
          <ul class="list-disc pl-5">
            <li>PostgreSQL, MySQL, Vitest, MSW (Mock Service Worker).</li>
          </ul>
        </div>
        <div>
          <h3 class="font-semibold">Herramientas de desarrollo:</h3>
          <ul class="list-disc list-inside pl-2">
            <li>Docker, Git, GitHub, VS Code, IntelliJ, Postman, DBeaver.</li>
          </ul>
        </div>
      </div>
    </section>

    <div class="h-[1px] w-full bg-black mb-6"></div>

    <!-- Formación Académica -->
    <section class="mb-6">
      <h2 class="text-xl font-bold uppercase mb-3">Formación Académica</h2>
      <div class="flex justify-between">
        <span class="font-medium w-[50%]">Ing. en Sistemas Computacionales</span
        >
        <span class="text-gray-600 w-[40%]">En curso 2025</span>
      </div>
      <div class="flex justify-between">
        <span class="font-medium w-[50%]"
          >Escuela Nacional Preparatoria No. 3</span
        >
        <span class="text-gray-600 w-[40%]">2018 - 2021</span>
      </div>
    </section>

    <div class="h-[1px] w-full bg-black mb-6"></div>

    <!-- Proyectos Personales -->
    <section class="mb-6 space-y-4">
      <h2 class="text-xl font-bold uppercase mb-3">Proyectos Personales</h2>

      <div>
        <h3 class="font-semibold">Kanban System (C# - ASP.NET & React)</h3>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            Implementación de
            <strong>Vertical Slice + Hexagonal Architecture</strong>
            para el desacoplamiento total de la lógica de negocio.
          </li>
          <li>
            Autenticación
            <strong> OpenID/OAuth2 (Google) </strong>
            con generación de
            <strong> JWT</strong>
            personalizados para la gestión de sesiones.
          </li>
          <li>
            Frontend con
            <strong> TanStack Router/Query y Shadcn UI; </strong>
            validación de integridad de datos mediante
            <strong> Zod </strong>.
          </li>
          <li>
            Estrategia de calidad mediante Vitest y MSW para el mockeo de
            servicios de API.
          </li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold">Sistema de Gestión (Laravel - En curso)</h3>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            Arquitectura
            <strong>MVC</strong>
            con
            <strong>Laravel y PostgreSQL</strong>; integración de
            <strong> Inertia.js </strong>
            para renderizado reactivo con
            <strong> React y TypeScript. </strong>
          </li>
          <li>
            Configuración y despliegue del entorno de desarrollo mediante
            <strong> contenedores Docker</strong>.
          </li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold">Share Link App (Node.js & React)</h3>
        <ul class="list-disc pl-5 space-y-1">
          <li>
            Seguridad avanzada:
            <strong> JWT </strong>
            con sistema de whitelist y refresh tokens.
          </li>
          <li>
            Gestión de medios: Integración con
            <strong> Cloudinary </strong>(upload y compresión) vía API REST.
          </li>
          <li>
            Validación robusta: Esquemas con
            <strong>Zod</strong>
            en frontend y backend para asegurar la integridad.
          </li>
        </ul>
      </div>
    </section>

    <div class="h-[1px] w-full bg-black mb-6"></div>

    <!-- Skills -->
    <section>
      <h2 class="text-xl font-bold uppercase mb-3">Skills</h2>
      <ul class="flex flex-wrap gap-1 list-disc list-inside">
        <li class="px-3 py-1">Pensamiento Analítico</li>
        <li class="px-3 py-1">Formación continua</li>
        <li class="px-3 py-1">Agilidad con los resultados</li>
        <li class="px-3 py-1">Orientación a Resultados</li>
      </ul>
    </section>

    <div
      class="mt-8 text-center flex flex-col items-center md:flex-row md:justify-center gap-3 print:hidden"
    >
      <a
        href="/"
        class="inline-block px-6 py-2 bg-gradient-to-r from-blue-500 to-purple-500 hover:from-blue-600 hover:to-purple-600 rounded text-white font-medium transform shadow-md hover:shadow-lg transition-all duration-500"
      >
        ← Volver al Portafolio
      </a>
      <a
        href="mockCv.pdf"
        download="Diego_Peralta_CV.pdf"
        class="inline-block px-6 py-2 bg-gray-800 text-white rounded hover:bg-gray-700 transition"
      >
        Descargar versión PDF
      </a>
    </div>
  </div>
</Layout>
