---
import HomeFooter from "@/components/HomeFooter.astro";
import NavbarProjects from "@/components/NavbarProjects.astro";
import ProjectChallengesSection from "@/components/ProjectChallengesSection.astro";
import ProjectCtaSection from "@/components/ProjectCtaSection.astro";
import ProjectGallery from "@/components/ProjectGallery.astro";
import ProjectHeroSection from "@/components/ProjectHeroSection.astro";
import ProjectLessonsSection from "@/components/ProjectLessonsSection.astro";
import ProjectRolAndProcessSection from "@/components/ProjectRolAndProcessSection.astro";
import ProjectStorySection from "@/components/ProjectStorySection.astro";
import ProjectTechnologiesSection from "@/components/ProjectTechnologiesSection.astro";
import { devLinks } from "@/data/projectDetails";
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div
    class="min-h-screen bg-gradient-to-br from-zinc-950 via-neutral-950 to-stone-950 text-white relative"
  >
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
      <div
        class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-radial from-purple-500/9 via-transparent to-transparent blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-0 right-1/4 w-[600px] h-[600px] bg-radial from-fuchsia-500/9 via-transparent to-transparent blur-3xl"
      >
      </div>
    </div>

    <NavbarProjects />
    <ProjectHeroSection
      metrics={devLinks.projectMetrics}
      description={devLinks.description}
    />
    <ProjectGallery
      mediaItems={devLinks.mediaItems}
      projectStats={devLinks.projectStats}
    />
    <ProjectStorySection storyDetails={devLinks.projectStory} />
    <ProjectTechnologiesSection techStack={devLinks.techStack} />
    <ProjectRolAndProcessSection
      projectRoleAndResp={devLinks.projectRolAndResp}
      timelinePhase={devLinks.timelinePhase}
    />
    <ProjectChallengesSection challenges={devLinks.challenges} />
    <ProjectLessonsSection learnings={devLinks.learnings} />
    <ProjectCtaSection />
    <HomeFooter />
  </div>
</Layout>
