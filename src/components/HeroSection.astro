---
import heroImage from "@/assets/home/pixelDiegoImg.webp";
import { ArrowRight, Calendar, Download, MapPin } from "lucide-react";
import DecoratedCard from "./DecoratedCard.astro";
import { AccentDotsOverlay, DecoratedLink } from "./ui/DecoratedLink";

const achievements = [
  { metric: "5+", label: "Proyectos Personales" },
  { metric: "2+", label: "Años Aprendiendo" },
  { metric: "10+", label: "Tecnologías" },
  { metric: "100%", label: "Dedicación" },
];
---

<section id="home" class="relative pt-32 md:pt-48 pb-20 md:pb-32 px-4 md:px-8">
  <div class="container mx-auto">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-16 items-center">
      <div class="lg:col-span-7 space-y-12">
        <div class="space-y-8">
          <div class="flex items-center space-x-4">
            <div
              class="min-w-3 min-h-3 bg-gradient-to-r from-blue-400 to-purple-400 rounded-full animate-pulse"
            >
            </div>
            <span
              class="text-zinc-400 text-sm tracking-[0.2em] uppercase font-light"
            >
              Disponible para nuevos proyectos
            </span>
          </div>

          <div class="space-y-6">
            <h1
              class="text-5xl md:text-7xl lg:text-8xl font-extralight leading-[0.9] tracking-tight"
            >
              <span class="block text-zinc-200 mb-4">Creando</span>
              <span
                class="block bg-gradient-to-r from-blue-400 via-violet-400 to-purple-400 bg-clip-text text-transparent"
              >
                experiencias
              </span>
              <span class="block text-zinc-300 text-6xl lg:text-7xl mt-4"
                >digitales</span
              >
            </h1>
            <p
              class="text-lg md:text-2xl text-zinc-400 font-extralight leading-relaxed max-w-2xl"
            >
              Desarrollador full stack junior apasionado por crear soluciones
              innovadoras y en búsqueda de mi primera oportunidad profesional
            </p>
          </div>

          <div class="flex items-center space-x-8 text-zinc-500 text-sm">
            <div class="flex items-center gap-2">
              <MapPin className="w-4 h-4" />
              <span>Cdmx, México</span>
            </div>
            <div class="flex items-center gap-2">
              <Calendar className="w-4 h-4" />
              <span>Disponible inmediatamente</span>
            </div>
          </div>

          <div class="flex flex-col gap-4 md:gap-6 pt-8">
            <DecoratedLink href="#portafolio">
              <AccentDotsOverlay />
              <span
                class="text-zinc-200 group-hover:text-zinc-100 font-medium text-lg transition-colors duration-300"
              >
                Explorar Portfolio
              </span>
              <div
                class="w-8 h-8 rounded-full bg-gradient-to-br from-emerald-400/20 to-blue-400/20 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
              >
                <ArrowRight
                  className="w-4 h-4 text-emerald-400 group-hover:text-emerald-300 group-hover:translate-x-1 transition-all duration-300"
                />
              </div>
            </DecoratedLink>

            <DecoratedLink
              variant="blue"
              size={"sm"}
              href="/Diego_Peralta_CV.pdf"
              download="Diego_Peralta_CV.pdf"
            >
              <Download
                className="w-5 h-5 text-zinc-300 group-hover:text-zinc-100 transition-colors duration-300"
              />
              <span
                class="text-zinc-300 group-hover:text-zinc-100 font-light text-lg transition-colors duration-300"
              >
                Curriculum Vitae
              </span>
            </DecoratedLink>
          </div>
        </div>

        {/* Achievements */}
        <div
          class="grid grid-cols-2 md:grid-cols-4 gap-8 pt-16 border-t border-zinc-800/30"
        >
          {
            achievements.map((achievement) => (
              <div class="text-center space-y-3">
                <div class="text-2xl md:text-3xl font-light text-zinc-100">
                  {achievement.metric}
                </div>
                <div class="text-sm text-zinc-500 tracking-wide">
                  {achievement.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="w-full flex justify-center lg:w-full lg:col-span-5">
        <div class="sm:w-[400px] md:w-[450px] lg:w-full">
          <DecoratedCard src={heroImage} alt="Imagen de Diego Peralta" />
        </div>
      </div>
    </div>
  </div>
</section>
