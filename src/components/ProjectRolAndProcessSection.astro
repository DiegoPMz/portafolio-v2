---
import type { ProjectRoleAndResp, TimelinePhase } from "@/data/projectDetails";
import { cn } from "@/lib/utils";
import { CheckCircle, Clock } from "lucide-react";
import { InfoCard } from "./InfoCard";
import Badge from "./ui/badge.astro";

interface Props {
  projectRoleAndResp: ProjectRoleAndResp[];
  timelinePhase: TimelinePhase[];
}

const { projectRoleAndResp, timelinePhase } = Astro.props;
---

<section class="relative py-20 px-8">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16 space-y-6">
      <h2 class="text-5xl font-extralight tracking-tight">
        <span class="text-zinc-200">Mi Rol &</span>
        <span
          class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent"
        >
          Proceso
        </span>
      </h2>
      <div
        class="w-32 h-px bg-gradient-to-r from-transparent via-blue-400 to-transparent mx-auto"
      >
      </div>
    </div>

    <div class="space-y-20">
      {/* Role Section */}
      <div class="space-y-12">
        <div class="text-center space-y-4">
          <h3 class="text-3xl font-light text-zinc-100">
            Responsabilidades del Proyecto
          </h3>
          <p class="text-zinc-400 max-w-2xl mx-auto">
            Como único desarrollador, asumí múltiples responsabilidades para
            llevar el proyecto desde la idea hasta producción
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {
            projectRoleAndResp.map((area) => (
              <InfoCard className="group">
                <InfoCard.Content className="text-left">
                  <div class="flex items-center space-x-4">
                    <div
                      class={cn(
                        "w-16 h-16 bg-gradient-to-br  rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300",
                        area.color,
                      )}
                    >
                      <area.icon className="w-8 h-8 text-blue-400" />
                    </div>
                    <h4 class="text-xl font-light text-zinc-100">
                      {area.category}
                    </h4>
                  </div>
                  <div class="space-y-3">
                    {area.responsibilities.map((responsibility) => (
                      <div class="flex items-center space-x-3">
                        <div class="w-2 h-2 bg-blue-400 rounded-full flex-shrink-0" />
                        <span class="text-zinc-400">{responsibility}</span>
                      </div>
                    ))}
                  </div>
                </InfoCard.Content>
              </InfoCard>
            ))
          }
        </div>
      </div>

      {/* Process Section */}
      <div class="space-y-12">
        <div class="text-center space-y-4">
          <h3 class="text-3xl font-light text-zinc-100">
            Metodología de Desarrollo
          </h3>
          <p class="text-zinc-400 max-w-2xl mx-auto">
            Un proceso iterativo y estructurado que garantiza calidad y
            eficiencia en cada etapa
          </p>
        </div>

        <div class="max-w-4xl mx-auto">
          <div class="relative">
            {/* Vertical Timeline Line */}
            <div
              class="absolute left-5 md:left-8 top-0 bottom-0 w-px bg-gradient-to-b from-blue-400 via-purple-400 to-blue-400 opacity-30"
            >
            </div>

            <div class="space-y-16">
              {
                timelinePhase.map((phase, index) => (
                  <div class="relative flex items-start space-x-4 md:space-x-8">
                    {/* Timeline Node */}
                    <div class="relative z-10 flex-shrink-0">
                      <div
                        class={cn(
                          "w-10 h-10 md:w-16 md:h-16 bg-gradient-to-br  rounded-full flex items-center justify-center shadow-2xl",
                          phase.color,
                        )}
                      >
                        <span class="text-zinc-900 font-bold text-lg">
                          {index + 1}
                        </span>
                      </div>
                    </div>

                    {/* Content */}
                    <div class="flex-1 pb-8">
                      <InfoCard>
                        <InfoCard.Content className=" p-6 md:p-8 text-left">
                          <div class="space-y-6">
                            <div class="flex flex-col md:flex-row md:items-center md:justify-between space-y-2 md:space-y-0">
                              <h4 class="text-2xl font-light text-zinc-100">
                                {phase.phase}
                              </h4>
                              <Badge className="bg-zinc-800/50 border-zinc-700/50 text-zinc-300 w-fit">
                                <Clock className="w-3 h-3 mr-1" />
                                {phase.duration}
                              </Badge>
                            </div>

                            <p class="text-zinc-400 leading-relaxed">
                              {phase.description}
                            </p>

                            <div class="space-y-3">
                              <h5 class="text-sm text-zinc-500 tracking-wider uppercase font-medium">
                                Entregables
                              </h5>
                              <div class="grid md:grid-cols-2 gap-2">
                                {phase.deliverables.map((deliverable) => (
                                  <div class="flex items-center space-x-2">
                                    <CheckCircle className="w-4 h-4 text-emerald-400 flex-shrink-0" />
                                    <span class="text-zinc-300 text-sm">
                                      {deliverable}
                                    </span>
                                  </div>
                                ))}
                              </div>
                            </div>
                          </div>
                        </InfoCard.Content>
                      </InfoCard>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
