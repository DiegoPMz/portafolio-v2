---
import { Github, Linkedin, Mail } from "lucide-react";
---

<footer class="relative py-8 md:py-16 px-4 md:px-8 border-t border-zinc-800/30">
  <div class="container mx-auto">
    <div class="max-w-7xl mx-auto">
      <div
        class="flex flex-col lg:flex-row justify-between items-center space-y-8 lg:space-y-0"
      >
        <div class="text-center lg:text-left">
          <div class="text-zinc-400 text-sm font-light">
            © 2025 Diego Peralta
          </div>
          <div class="text-zinc-600 text-xs mt-2">
            Hecho con Astro, React y Tailwind CSS
          </div>
        </div>
        <div class="flex space-x-8">
          <a
            href="https://github.com/DiegoPMz"
            target="_blank"
            class="text-zinc-500 hover:text-blue-400 transition-all duration-500 hover:scale-110"
          >
            <Github className="w-6 h-6" />
          </a>
          <a
            href="https://www.linkedin.com/in/diego-peralta-b9b012291/"
            target="_blank"
            class="text-zinc-500 hover:text-blue-400 transition-all duration-500 hover:scale-110"
          >
            <Linkedin className="w-6 h-6" />
          </a>
          <a
            href="#"
            class="text-zinc-500 hover:text-blue-400 transition-all duration-500 hover:scale-110"
          >
            <Mail className="w-6 h-6" />
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
