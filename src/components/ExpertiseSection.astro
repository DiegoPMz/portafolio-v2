---
import { Database, Globe, Server, ShieldCheck } from "lucide-react";
import ExpertiseCard from "./ExpertiseCard.astro";

const expertise = [
  {
    title: "Arquitectura Frontend",
    description:
      "Desarrollo de interfaces dinámicas y mantenibles con React y TypeScript, aplicando librerías modernas para experiencias escalables",
    technologies: [
      "React",
      "TypeScript",
      "TanStack Query",
      "TanStack Router",
      "Tailwind CSS",
      "Shadcn UI",
      "Zod",
      "Axios",
      "Astro",
      "Vite",
    ],
    icon: Globe,
  },
  {
    title: "Testing Frontend",
    description:
      "Pruebas unitarias e integración para asegurar calidad y confiabilidad en aplicaciones web",
    technologies: ["Vitest", "Testing Library", "MSW", "Jest"],
    icon: ShieldCheck,
  },
  {
    title: "Desarrollo Backend",
    description:
      "Construcción de APIs seguras y sistemas escalables aplicando principios de Clean Architecture",
    technologies: [
      "C# (ASP.NET Core)",
      "Node.js",
      "Express",
      "JWT",
      "OAuth2/OpenID Connect",
      "API REST",
      "Arquitectura Hexagonal",
      "Vertical Slice",
      "MVC",
    ],
    icon: Server,
  },
  {
    title: "Gestión de Datos",
    description:
      "Diseño e implementación de soluciones de almacenamiento eficientes y confiables",
    technologies: ["PostgreSQL", "MySQL", "MongoDB"],
    icon: Database,
  },
];
---

<section id="expertise" class="relative py-16 md:py-32 px-4 md:px-8">
  <div class="container mx-auto">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-24">
        <div class="space-y-6">
          <h2 class="text-4xl md:text-6xl font-extralight tracking-tight">
            <span class="text-zinc-200">Áreas de</span>
            <span
              class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent"
            >
              Conocimiento
            </span>
          </h2>
          <div
            class="w-32 h-px bg-gradient-to-r from-transparent via-blue-400 to-transparent mx-auto"
          >
          </div>
          <p
            class="text-xl text-zinc-400 font-light max-w-3xl mx-auto leading-relaxed"
          >
            Aplicación de tecnologías web actuales para crear proyectos
            funcionales con código limpio y eficiente.
          </p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6 md:gap-12">
        {expertise.map((area) => <ExpertiseCard expertise={area} />)}
      </div>
    </div>
  </div>
</section>
