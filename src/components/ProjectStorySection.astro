---
import type { ProjectStoryData } from "@/data/projectDetails";
import { Lightbulb, Target, TrendingUp } from "lucide-react";
import { ProjectStoryCard } from "./ProjectStoryCard";

interface Props {
  storyDetails: ProjectStoryData;
}

const { storyDetails } = Astro.props;
---

<section class="relative py-20 px-8">
  <div class="max-w-5xl mx-auto">
    <div class="space-y-16">
      <div class="text-center space-y-6">
        <h2 class="text-5xl font-extralight tracking-tight">
          <span class="text-zinc-200">La</span>
          <span
            class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent"
          >
            Historia
          </span>
        </h2>
        <div
          class="w-32 h-px bg-gradient-to-r from-transparent via-blue-400 to-transparent mx-auto"
        >
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-12">
        <ProjectStoryCard>
          <ProjectStoryCard.StoryCardContent>
            <div
              class="w-16 h-16 bg-gradient-to-br from-yellow-500/20 to-orange-500/20 rounded-2xl flex items-center justify-center mx-auto"
            >
              <Lightbulb className="w-8 h-8 text-yellow-400" />
            </div>
            <div>
              <h3 class="text-xl font-light text-zinc-100 mb-4">El Problema</h3>
              <p class="text-zinc-400 leading-relaxed">
                {storyDetails.problem}
              </p>
            </div>
          </ProjectStoryCard.StoryCardContent>
        </ProjectStoryCard>

        <ProjectStoryCard>
          <ProjectStoryCard.StoryCardContent>
            <div
              class="w-16 h-16 bg-gradient-to-br from-blue-500/20 to-purple-500/20 rounded-2xl flex items-center justify-center mx-auto"
            >
              <Target className="w-8 h-8 text-blue-400" />
            </div>
            <div>
              <h3 class="text-xl font-light text-zinc-100 mb-4">La Solución</h3>
              <p class="text-zinc-400 leading-relaxed">
                {storyDetails.solution}
              </p>
            </div>
          </ProjectStoryCard.StoryCardContent>
        </ProjectStoryCard>

        <ProjectStoryCard>
          <ProjectStoryCard.StoryCardContent>
            <div
              class="w-16 h-16 bg-gradient-to-br from-emerald-500/20 to-green-500/20 rounded-2xl flex items-center justify-center mx-auto"
            >
              <TrendingUp className="w-8 h-8 text-emerald-400" />
            </div>
            <div>
              <h3 class="text-xl font-light text-zinc-100 mb-4">El Impacto</h3>
              <p class="text-zinc-400 leading-relaxed">
                {storyDetails.impact}
              </p>
            </div>
          </ProjectStoryCard.StoryCardContent>
        </ProjectStoryCard>
      </div>
    </div>
  </div>
</section>
