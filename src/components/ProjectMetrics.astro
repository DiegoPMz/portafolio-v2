---
import type { ProjectMetric } from "@/data/projectDetails";

interface Props {
  metric: ProjectMetric;
}

const { metric } = Astro.props;
---

<div class="text-center space-y-3">
  <div
    class="w-16 h-16 bg-gradient-to-br from-zinc-800/50 to-zinc-900/50 backdrop-blur-sm rounded-2xl flex items-center justify-center mx-auto border border-zinc-700/30"
  >
    <metric.icon className="w-8 h-8 text-blue-400" />
  </div>
  <div>
    <div class="text-2xl font-light text-zinc-100">
      {metric.label}
    </div>
    <div class="text-sm text-zinc-500">{metric.value}</div>
  </div>
</div>
