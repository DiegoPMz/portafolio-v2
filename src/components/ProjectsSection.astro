---
import ProjectCard from "./ProjectCard.astro";
import previewDevLinks from "@/assets/home/previewDevLinks.webp";
import previewKanbanApp from "@/assets/home/previewKanbanApp.webp";
import previewWITW from "@/assets/home/previewWITW.webp";
import { devLinksProjectDetails } from "@/data/dev-links.project";
import { kanbanProjectDetails } from "@/data/kanban-app.project";
import { whereInTheWorldProjectDetails } from "@/data/where-in-the-world.project";

export interface ProjectIntroductionDetails {
  title: string;
  subtitle: string;
  description: string;
  technologies: string[];
  image: string;
  live: string;
  category: string;
  year: string;
  status: string;
  pathname: string;
}

const projects: ProjectIntroductionDetails[] = [
  {
    title: "DevLinks",
    subtitle: "App para crear tu perfil de enlaces personalizado",
    description:
      "Centraliza tus enlaces clave en un perfil profesional personalizable. Agrega tus redes sociales para que tu audiencia pueda encontrarte fácilmente. Actualiza tu contenido en cualquier momento sin cambiar el enlace principal.",
    technologies: [
      "React",
      "Tailwind CSS",
      "Zustand",
      "TypeScript",
      "Nodejs",
      "Express",
      "MongoDb",
    ],
    image: previewDevLinks.src,
    live: "https://devlink-frontend.vercel.app/",
    category: "Web Application",
    year: "2024",
    status: "Production",
    pathname: devLinksProjectDetails.metaData.pathname,
  },
  {
    title: "KanbanApp",
    subtitle: "Aplicación para organizar tareas diarias",
    description:
      "Una app minimalista para gestionar tareas al estilo Kanban. Sin complicaciones: solo tableros, tarjetas y arrastrar/soltar. Perfecta para quienes aman la productividad sin distracciones.",
    technologies: ["React", "Vite", "Dnd kit"],
    image: previewKanbanApp.src,
    live: "https://kanban-app-nine-xi.vercel.app/",
    category: "Web Application",
    year: "2023",
    status: "Production",
    pathname: kanbanProjectDetails.metaData.pathname,
  },
  {
    title: "Where in the world",
    subtitle: "Página que te muestra datos clave de cada país",
    description:
      "Fuente de consulta organizada con información geográfica y política actualizada. Contiene: monedas, dominios web oficiales, divisiones administrativas y datos clave de cada país. Perfecta para proyectos académicos o aprendizaje.",
    technologies: ["React", "Vite", "React router", "Api-countries"],
    image: previewWITW.src,
    live: "https://where-in-the-world-ashy.vercel.app/",
    category: "Reference Web App",
    year: "2023",
    status: "Production",
    pathname: whereInTheWorldProjectDetails.metaData.pathname,
  },
];
---

<section id="portafolio" class="relative py-16 md:py-32 px-4 md:px-8">
  <div class="container mx-auto">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-24">
        <div class="space-y-6">
          <h2 class="text-4xl md:text-6xl font-extralight tracking-tight">
            <span class="text-zinc-200">Portafolio</span>
            <span
              class="bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent"
            >
              Seleccionado
            </span>
          </h2>
          <div
            class="w-32 h-px bg-gradient-to-r from-transparent via-blue-400 to-transparent mx-auto"
          >
          </div>
          <p
            class="text-xl text-zinc-400 font-light max-w-3xl mx-auto leading-relaxed"
          >
            Una cuidadosa selección de proyectos que demuestran excelencia
            técnica, innovación y impacto empresarial real.
          </p>
        </div>
      </div>

      <div class="space-y-32">
        {
          projects.map((project, index) => (
            <ProjectCard project={project} position={index} />
          ))
        }
      </div>
    </div>
  </div>
</section>
