---
import type { LucideProps } from "lucide-react";

interface Props {
  expertise: {
    title: string;
    description: string;
    technologies: string[];
    icon: React.ForwardRefExoticComponent<
      Omit<LucideProps, "ref"> & React.RefAttributes<SVGSVGElement>
    >;
  };
}

const { expertise } = Astro.props;
---

<div
  class="rounded-lg border shadow-sm bg-zinc-900/30 border-zinc-800/30 hover:bg-zinc-900/50 transition-all duration-700 group backdrop-blur-sm"
>
  <div class="p-6 md:p-12">
    <div class="space-y-8">
      <div class="flex items-start space-x-6">
        <div
          class="w-16 h-16 bg-gradient-to-br from-blue-500/20 to-purple-500/20 rounded-2xl flex items-center justify-center"
        >
          <expertise.icon className="w-8 h-8 text-blue-400" />
        </div>
        <div class="flex-1 space-y-4">
          <h3 class="text-2xl font-light text-zinc-100">
            {expertise.title}
          </h3>
          <p class="text-zinc-400 leading-relaxed font-light">
            {expertise.description}
          </p>
        </div>
      </div>

      <div class="flex flex-wrap gap-3 pt-4">
        {
          expertise.technologies.map((tech) => (
            <div class="inline-flex items-center rounded-full border text-xs group-hover:outline-none group-hover:ring-2 group-hover:ring-ring group-hover:ring-offset-2 border-zinc-700/50  text-zinc-400 group-hover:border-zinc-600/60 group-hover:text-zinc-100 transition-all duration-300 px-4 py-2 font-light">
              {tech}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
