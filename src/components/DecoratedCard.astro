---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { Award } from "lucide-react";

interface Props {
  src: ImageMetadata;
  alt: string;
}

const { src, alt } = Astro.props;
---

<div class="relative">
  <div
    class="absolute inset-0 bg-gradient-to-br from-blue-500/20 via-violet-500/20 to-purple-500/20 blur-3xl rounded-full"
  >
  </div>
  <div
    class="relative bg-gradient-to-br from-zinc-800/50 to-zinc-900/50 backdrop-blur-sm rounded-3xl p-2 border border-zinc-700/30"
  >
    <Image
      src={src}
      alt={alt}
      loading={"eager"}
      width={500}
      height={500}
      class={"rounded-2xl w-full object-cover aspect-square"}
    />

    <div
      class="absolute -top-6 -right-3 md:-right-6 w-16 h-16 bg-gradient-to-br from-blue-400 to-purple-400 rounded-2xl flex items-center justify-center shadow-2xl shadow-blue-500/30"
    >
      <Award className="w-8 h-8 text-zinc-900" />
    </div>
  </div>
</div>
