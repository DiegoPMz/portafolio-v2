---
import { ClientRouter } from "astro:transitions";

import "../styles/global.css";

export type LayoutMetaData = {
  title: string;
  description: string;
  keywords?: string;
  pathname: string;
  ogDescription?: string;
};

type Props = LayoutMetaData;
const {
  title,
  description,
  keywords,
  pathname,
  ogDescription = "Explora mis proyectos y habilidades como desarrollador Full-stack",
} = Astro.props;

const baseRoute = Astro.url.origin;

const anim = {
  old: {
    name: "zoomOut",
    duration: "0.4s",
    easing: "cubic-bezier(0.4, 0, 0.2, 1)",
  },
  new: {
    name: "zoomIn",
    duration: "0.5s",
    easing: "cubic-bezier(0, 0, 0.2, 1)",
  },
};

const customTransition = {
  forwards: anim,
  backwards: anim,
};
---

<!doctype html>
<html lang="es" transition:animate={customTransition}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/portafolio_logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Diego Peralta" />
    <meta name="robots" content="index, follow" />
    <meta
      property="og:title"
      content="Diego Peralta - Portafolio de Desarrollador Web"
    />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${baseRoute}/${pathname}`} />
    <meta property="og:image" content="/portafolio_logo.svg" />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @keyframes zoomOut {
    from {
      opacity: 1;
      transform: scale(1);
      filter: blur(0px);
    }
    to {
      opacity: 0;
      transform: scale(0.95);
      filter: blur(10px);
    }
  }

  @keyframes zoomIn {
    from {
      opacity: 0;
      transform: scale(1.05);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  ::view-transition-group(root) {
    /* Usamos el color oscuro para que el morph sea elegante */
    background-color: #09090b;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    mix-blend-mode: normal;
  }
</style>
