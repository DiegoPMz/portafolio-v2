---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

export type LayoutMetaData = {
  title: string;
  description: string;
  keywords?: string;
  pathname: string;
  ogDescription?: string;
};

type Props = LayoutMetaData;
const {
  title,
  description,
  keywords,
  pathname,
  ogDescription = "Explora mis proyectos y habilidades como desarrollador Full-stack",
} = Astro.props;

const baseRoute = Astro.url.origin;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/portafolio_logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Diego Peralta" />
    <meta name="robots" content="index, follow" />
    <meta
      property="og:title"
      content="Diego Peralta - Portafolio de Desarrollador Web"
    />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${baseRoute}/${pathname}`} />
    <meta property="og:image" content="/portafolio_logo.svg" />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
